# ── Copy to .env.local (dev) or .env.production (server build) ────────────
# These values are baked into the static files at build time (npm run build).

# Laravel API base URL (must include /api/v1, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8020/api/v1

# Optional: Google sign-in. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Bank-transfer details shown on the billing page.
# The "Bank transfer" option is only shown when NEXT_PUBLIC_BANK_ACCOUNT_NUMBER is set.
NEXT_PUBLIC_BANK_NAME=Demo Bank Ltd.
NEXT_PUBLIC_BANK_ACCOUNT_NAME=OrangeToolz Ltd.
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=1234567890
NEXT_PUBLIC_BANK_SWIFT=DEMO0000XXX

# Contact address used on the site
NEXT_PUBLIC_SUPPORT_EMAIL=design@orangetoolz.com
