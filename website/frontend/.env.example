# ── Copy to .env.local (dev) or .env.production (server build) ────────────
# These values are baked into the static files at build time (npm run build).

# Laravel API base URL (must include /api/v1, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8020/api/v1

# Optional: Google sign-in. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Bank-transfer details shown on the billing page.
# The "Bank transfer" option is only shown when NEXT_PUBLIC_BANK_ACCOUNT_NUMBER is set.
NEXT_PUBLIC_BANK_NAME=Example Bank
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Account Holder Name
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000000
NEXT_PUBLIC_BANK_BRANCH=Branch Name

# bKash payment details. The "bKash" option is shown when NEXT_PUBLIC_BKASH_NUMBER is set.
NEXT_PUBLIC_BKASH_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_BKASH_TYPE=Send Money

# Payoneer payment. Shown when NEXT_PUBLIC_PAYONEER_EMAIL is set.
NEXT_PUBLIC_PAYONEER_EMAIL=payments@example.com

# Wise payment. Shown when NEXT_PUBLIC_WISE_EMAIL is set.
NEXT_PUBLIC_WISE_EMAIL=payments@example.com

# Contact address used on the site
NEXT_PUBLIC_SUPPORT_EMAIL=0devdesign.studio@gmail.com
