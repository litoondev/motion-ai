APP_NAME="Motion AI API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS="${FRONTEND_URL},${ADMIN_URL}"

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=motion_ai
DB_USERNAME=motion_ai
DB_PASSWORD=secret

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Motion AI"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ADMIN_EMAIL=admin@example.com

QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file

PLUGIN_FILE_PATH=plugin/motion-ai-plugin.zip
