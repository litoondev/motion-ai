// Motion AI – After Effects Plugin
// SQLite-compatible schema (enums stored as String)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth compatible) ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ────────────────────────────────────────────────────────────
// role: "USER" | "ADMIN"

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           String    @default("USER")   // "USER" | "ADMIN"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trialUsed      Boolean   @default(false)
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  accounts  Account[]
  sessions  Session[]
  licenses  License[]
  devices   Device[]
  payments  Payment[]
}

// ─── License ─────────────────────────────────────────────────────────
// type:   "TRIAL" | "PAID"
// status: "ACTIVE" | "EXPIRED" | "SUSPENDED" | "REVOKED"

model License {
  id           String   @id @default(cuid())
  userId       String
  licenseKey   String   @unique
  type         String   @default("PAID")   // "TRIAL" | "PAID"
  status       String   @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "SUSPENDED" | "REVOKED"

  purchasedAt  DateTime @default(now())
  expiresAt    DateTime?
  updatedUntil DateTime?

  seatCount    Int      @default(1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices  Device[]
  payment  Payment?
}

// ─── Device ──────────────────────────────────────────────────────────

model Device {
  id          String   @id @default(cuid())
  userId      String
  licenseId   String?

  deviceId    String   @unique
  deviceName  String?
  platform    String?
  aeVersion   String?

  linkedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License? @relation(fields: [licenseId], references: [id])
}

// ─── Payment ─────────────────────────────────────────────────────────
// method: "CARD" | "BANK_TRANSFER"
// status: "PENDING" | "APPROVED" | "REJECTED" | "REFUNDED"

model Payment {
  id              String   @id @default(cuid())
  userId          String
  licenseId       String?  @unique

  method          String   // "CARD" | "BANK_TRANSFER"
  status          String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "REFUNDED"

  amount          Float
  currency        String   @default("USD")

  bankTxRef       String?
  bankSlipUrl     String?
  adminNote       String?
  reviewedAt      DateTime?
  reviewedBy      String?

  stripeSessionId String?
  stripeTxId      String?

  seatCount       Int      @default(1)
  yearCount       Int      @default(1)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License? @relation(fields: [licenseId], references: [id])
}
